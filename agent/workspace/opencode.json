{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "spark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Spark local vLLM",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "local"
      },
      "models": {
        "fast": {
          "name": "Qwen3.6-35B-A3B NVFP4 (fast)",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true
        },
        "deep": {
          "name": "gpt-oss-120b MXFP4 (deep)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "spark/fast",
  "small_model": "spark/fast",
  "default_agent": "engineer",
  "agent": {
    "engineer": {
      "mode": "primary",
      "description": "Field engineer: diagnoses and repairs on-site equipment through target-host tools, keeps device notes between sessions.",
      "prompt": "{file:./prompts/engineer.md}"
    },
    "compaction": {
      "prompt": "{file:./prompts/compaction.md}"
    }
  },
  "compaction": {
    "auto": true
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 16384
  },
  "instructions": [
    "docs/**/*.md"
  ],
  "mcp": {
    "target-host": {
      "type": "local",
      "command": [
        "/opt/support/venv/bin/python",
        "/opt/support/mcp/target_host.py"
      ],
      "enabled": true,
      "environment": {
        "SUPPORT_TARGETS_DIR": "/opt/support/targets",
        "SUPPORT_AGENT_KEY": "/opt/support/keys/agent_ed25519",
        "SUPPORT_AUDIT_LOG": "/var/log/support/audit.jsonl"
      }
    },
    "library": {
      "type": "local",
      "command": [
        "/opt/support/venv/bin/python",
        "/opt/support/mcp/library.py"
      ],
      "enabled": true,
      "environment": {
        "LIBRARY_DIR": "/opt/library",
        "HF_HUB_OFFLINE": "1"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "question": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "edit": "deny",
    "bash": "deny",
    "target-host_target_list": "allow",
    "target-host_collect_facts": "allow",
    "target-host_run_readonly": "allow",
    "target-host_read_file": "allow",
    "target-host_run_change": "ask",
    "target-host_write_file": "ask",
    "target-host_reboot_and_wait": "ask",
    "target-host_device_list": "allow",
    "target-host_observe": "allow",
    "target-host_scan": "allow",
    "target-host_device_act": "ask",
    "target-host_workbench_run": "ask",
    "target-host_device_actuate": "ask",
    "target-host_device_recover": "ask",
    "library_library_search": "allow",
    "library_library_read": "allow",
    "library_library_list": "allow",
    "todowrite": "allow",
    "target-host_device_notes": "allow",
    "target-host_device_note_save": "allow",
    "external_directory": {
      "*": "ask",
      "~/.local/share/opencode/tool-output/*": "allow"
    }
  }
}
