#!/usr/bin/env bash
# support-ctl — operator CLI for the Spark support stack.
#   support-ctl status                      stack health (LLM, targets, docs)
#   support-ctl model fast|deep|nemotron    switch the LLM profile (mutually exclusive)
#   support-ctl target add NAME USER@HOST [--password-stdin]   register a Linux host (ssh), install the agent key there
#   support-ctl target list|test NAME
#   support-ctl device add NAME TYPE KEY=VAL...   register a non-ssh device: serial PORT= BAUD= | can IFACE= BITRATE= |
#                                           modbus HOST= PORT= UNIT= (or PORT=/dev/tty.. BAUD=) | http URL= [AUTH=u:p]
#   support-ctl device list|test NAME|rm NAME
#   support-ctl scan [all|usb|serial|can|net|mdns]   what is physically around: USB, serial ports, CAN, hosts per link, mDNS
#   support-ctl workbench build|status|runs   sandbox image for agent scripts (build needs internet once)
#   support-ctl docs status|reload          token estimate for docs/; reload = restart the agent engine to pick up new docs
#   support-ctl net status|peers|lan|direct RJ45 mode (auto: lan→direct fallback) and hosts on the direct link
#   support-ctl net hotspot on|off|auto on|auto off   Wi-Fi access point Workbench-Support; auto = start at boot when no known Wi-Fi is around
#   support-ctl agent                       open the agent TUI (OpenCode) in the workspace
#   support-ctl gui                         open the web UI in the default browser (desktop shortcut)
#   support-ctl install-desktop             install the Spark Support icon + launcher for the current user
#   support-ctl web [password]              start/enable the web UI on :8080 + :8443 (user "support"; sets the password; issues the local TLS cert)
#   support-ctl self unlock [MIN] | lock | status   let the agent change the Workbench box itself (target self) for MIN
#                                           minutes (default 30, max 240); each change still asks for approval
#   support-ctl library add FILE... [--kind manual|datasheet|playbook|paper|note] | search QUERY | list | rm ID | stats | embed
#                                           offline library (/opt/library) searched by the agent (library_search) and the UI
#   support-ctl bench                       run tests/bench.py against the active profile
#   support-ctl update                      git pull the Workbench repo and redeploy software (models untouched)
#   support-ctl version                     installed versions (OS, driver, opencode, vLLM image, models)
set -euo pipefail

SUPPORT_DIR=${SUPPORT_DIR:-/opt/support}
STACK_DIR=${STACK_DIR:-/opt/support-stack}
WORKSPACE=$SUPPORT_DIR/workspace
TARGETS=$SUPPORT_DIR/targets
KEY=$SUPPORT_DIR/keys/agent_ed25519
LLM_URL=${LLM_URL:-http://127.0.0.1:8000}
# Interface names differ between DGX OS builds; detect, allow override via env.
RJ45_IF=${RJ45_IF:-$(ip -o link | awk -F': ' '$2 ~ /^en/ && $2 !~ /docker|veth|br-/ {print $2}' | head -1)}
WIFI_IF=${WIFI_IF:-$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2=="wifi"{print $1}' | head -1)}

die() { echo "support-ctl: $*" >&2; exit 1; }

ensure_key() {
  if [ ! -f "$KEY" ]; then
    mkdir -p "$(dirname "$KEY")"
    ssh-keygen -q -t ed25519 -N "" -C "support-agent@$(hostname)" -f "$KEY"
    chmod 600 "$KEY"
    echo "generated agent key $KEY"
  fi
}

cmd_status() {
  echo "== LLM"
  for p in fast deep; do
    printf '  llm@%s: %s\n' "$p" "$(systemctl is-active "llm@$p" 2>/dev/null || true)"
  done
  if curl -sf "$LLM_URL/v1/models" >/dev/null 2>&1; then
    curl -sf "$LLM_URL/v1/models" | python3 -c 'import json,sys; print("  serving:", ", ".join(m["id"] for m in json.load(sys.stdin)["data"]))'
  else
    echo "  API: not ready"
  fi
  echo "== Web UI (login: support)"
  for a in $(hostname -I); do echo "  http://$a:8080"; done
  echo "  http://$(hostname).local:8080  (mDNS, с ноутбука в той же сети/хотспоте)"
  echo "== Devices"; cmd_device list
  echo "== Workbench"; cmd_workbench status
  echo "== Docs"; cmd_docs status
  echo "== Audit: $([ -f /var/log/support/audit.jsonl ] && wc -l < /var/log/support/audit.jsonl || echo 0) entries"
}

model_dir_present() {  # model_dir_present fast|deep -> 0 if the profile's weights are on disk
  local mp; mp=$(sed -n 's|^MODEL_PATH=/models/||p' "$STACK_DIR/env/$1.env")
  [ -n "$mp" ] && { [ -f "/opt/models/$mp/.workbench-rev" ] || [ -f "/opt/models/$mp/config.json" ]; }
}

cmd_model() {
  local want=${1:-}; [[ "$want" =~ ^(fast|deep|nemotron)$ ]] || die "usage: support-ctl model fast|deep|nemotron"
  model_dir_present "$want" || die "weights for profile '$want' are not on disk ($(sed -n 's|^MODEL_PATH=|/opt|p' "$STACK_DIR/env/$want.env")) — run install/fetch-models.sh $want first"
  sudo systemctl start "llm@$want"       # Conflicts= in the unit stops the other profile
  echo "starting llm@$want (model load takes several minutes) ..."
  for _ in $(seq 1 120); do
    curl -sf "$LLM_URL/health" >/dev/null 2>&1 && { echo "ready"; return; }
    systemctl is-active --quiet "llm@$want" || die "llm@$want failed: journalctl -u llm@$want"
    sleep 5
  done
  die "timed out waiting for $LLM_URL/health"
}

cmd_target() {
  local sub=${1:-list}; shift || true
  mkdir -p "$TARGETS"
  case "$sub" in
    list)
      ls "$TARGETS"/*.env >/dev/null 2>&1 || { echo "  (none)"; return; }
      for f in "$TARGETS"/*.env; do
        # shellcheck disable=SC1090
        ( . "$f"; printf '  %s: %s@%s:%s  (mdns: %s, mac: %s, last: %s)\n' "$(basename "$f" .env)" "${USER:-support-agent}" "$HOST" "${PORT:-22}" "${MDNS:-—}" "${MAC:-—}" "${IP_LAST:-—}" )
      done ;;
    add)
      local name=${1:-} userhost=${2:-} pwstdin=${3:-}; [ -n "$name" ] && [ -n "$userhost" ] || die "usage: support-ctl target add NAME USER@HOST[:PORT] [--password-stdin]"
      [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,31}$ ]] || die "bad target name: $name"
      ensure_key
      local host=${userhost#*@} port=22; [[ "$host" == *:* ]] && { port=${host#*:}; host=${host%%:*}; }
      local ruser=${userhost%@*}; local userhost_np="$ruser@$host"
      if [ "$pwstdin" = "--password-stdin" ]; then
        # Non-interactive (web UI "Подключить устройство"): the password arrives on stdin once, is used for the ssh
        # login (SSH_ASKPASS) and for sudo on the target (sudo -S), and is never written anywhere but a 0600 file
        # in a private temp dir that is removed right after.
        local pw tmp; IFS= read -r pw || true; [ -n "$pw" ] || die "empty password"
        tmp=$(mktemp -d); chmod 700 "$tmp"; printf '%s\n' "$pw" > "$tmp/pw"; chmod 600 "$tmp/pw"
        printf '#!/bin/sh\ncat "%s/pw"\n' "$tmp" > "$tmp/askpass"; chmod 700 "$tmp/askpass"
        local b64; b64=$(base64 -w0 < "$SUPPORT_DIR/bin/onboard-target.sh")
        echo "Installing agent user on $host as $ruser (password from the operator) ..."
        local rc=0
        SSH_ASKPASS="$tmp/askpass" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 setsid -w ssh \
          -o StrictHostKeyChecking=accept-new -o HostKeyAlias="$name" -o ConnectTimeout=15 -o NumberOfPasswordPrompts=1 \
          -o PreferredAuthentications=password,keyboard-interactive -o PubkeyAuthentication=no -p "$port" "$userhost_np" \
          "S=\$(mktemp); echo $b64 | base64 -d > \$S; sudo -S -p '' bash \$S '$(cat "$KEY.pub")'; r=\$?; rm -f \$S; exit \$r" \
          < "$tmp/pw" || rc=$?
        rm -rf "$tmp"; unset pw
        [ "$rc" = 0 ] || die "onboarding failed (rc=$rc): wrong password, no sudo for $ruser, or host unreachable"
      else
        echo "Installing agent user on $host via $userhost_np (asks for that user's password/sudo) ..."
        ssh -t -p "$port" "$userhost_np" "sudo bash -s" < "$SUPPORT_DIR/bin/onboard-target.sh" -- "$(cat "$KEY.pub")"
      fi
      # Identity that survives address changes: hostname (mDNS) + MAC of the link we see it on.
      local sshq="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o HostKeyAlias=$name -i $KEY -p $port support-agent@$host"
      local rhost; rhost=$($sshq hostname 2>/dev/null || true)
      local ip4; ip4=$(getent ahostsv4 "$host" | awk 'NR==1{print $1}')
      ping -c 1 -W 1 "$ip4" >/dev/null 2>&1 || true
      local mac; mac=$(ip neigh show "$ip4" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="lladdr") print $(i+1)}' | head -1)
      [ -z "$mac" ] && mac=$($sshq "ip -o link show | awk -F'link/ether ' '/link\/ether/ && !/docker|veth|br-/{print \$2}' | awk '{print \$1}' | head -1" 2>/dev/null || true)
      [ -f "$TARGETS/$name.env" ] && cp "$TARGETS/$name.env" "$TARGETS/$name.env.bak-$(date +%Y%m%d-%H%M%S)"
      {
        echo "HOST=auto"; echo "USER=support-agent"; echo "PORT=$port"; echo "KEY=$KEY"
        [ -n "$rhost" ] && echo "MDNS=$rhost.local"
        [ -n "$mac" ] && echo "MAC=$mac"
        echo "IP_LAST=$host"
      } > "$TARGETS/$name.env"
      echo "saved $TARGETS/$name.env (hostname: ${rhost:-?}, MAC: ${mac:-?})"; cmd_target test "$name" ;;
    test)
      local name=${1:-ws}; [ -f "$TARGETS/$name.env" ] || die "no such target: $name"
      # shellcheck disable=SC1090
      local rhost; rhost=$("$SUPPORT_DIR/bin/support-resolve-target" "$name" -v) || die "cannot find target $name on any link"
      echo "  resolved: $rhost"
      # shellcheck disable=SC1090
      ( . "$TARGETS/$name.env"
        ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o HostKeyAlias="$name" -o ConnectTimeout=10 -i "${KEY:-$KEY}" -p "${PORT:-22}" "${USER:-support-agent}@$rhost" \
          "echo \"  ok: \$(hostname) \$(uname -r)\"; sudo -n true && echo \"  sudo: ok\" || echo \"  sudo: MISSING\"" ) ;;
    *) die "usage: support-ctl target list|add|test" ;;
  esac
}

cmd_device() {
  local sub=${1:-list}; shift || true
  mkdir -p "$TARGETS"
  case "$sub" in
    list)
      ls "$TARGETS"/*.env >/dev/null 2>&1 || { echo "  (none)"; return; }
      for f in "$TARGETS"/*.env; do
        # shellcheck disable=SC1090
        ( unset TYPE HOST PORT USER MDNS MAC IP_LAST BAUD IFACE BITRATE UNIT URL; . "$f"
          case "${TYPE:-ssh}" in
            serial) printf '  %-10s serial   %s @ %s\n' "$(basename "$f" .env)" "${PORT:-/dev/ttyUSB0}" "${BAUD:-115200}" ;;
            can)    printf '  %-10s can      %s @ %s\n' "$(basename "$f" .env)" "${IFACE:-can0}" "${BITRATE:-500000}" ;;
            modbus) case "${PORT:-502}" in /dev/*) printf '  %-10s modbus   rtu %s @ %s unit %s\n' "$(basename "$f" .env)" "$PORT" "${BAUD:-9600}" "${UNIT:-1}" ;;
                                           *) printf '  %-10s modbus   tcp %s:%s unit %s\n' "$(basename "$f" .env)" "$HOST" "${PORT:-502}" "${UNIT:-1}" ;; esac ;;
            http)   printf '  %-10s http     %s\n' "$(basename "$f" .env)" "$URL" ;;
            *)      printf '  %-10s ssh      %s@%s:%s  (mdns: %s, mac: %s, last: %s)\n' "$(basename "$f" .env)" "${USER:-support-agent}" "${HOST:-auto}" "${PORT:-22}" "${MDNS:-—}" "${MAC:-—}" "${IP_LAST:-—}" ;;
          esac )
      done ;;
    add)
      local name=${1:-} type=${2:-}; shift 2 || true
      [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "usage: support-ctl device add NAME TYPE KEY=VAL...   (TYPE: ssh|serial|can|modbus|http)"
      case "$type" in
        ssh) [ -n "${1:-}" ] || die "ssh devices: support-ctl target add NAME USER@HOST"; cmd_target add "$name" "$1"; return ;;
        serial|can|modbus|http) ;;
        *) die "TYPE must be ssh|serial|can|modbus|http" ;;
      esac
      { echo "TYPE=$type"; for kv in "$@"; do [[ "$kv" =~ ^[A-Z_]+=.+$ ]] || die "expected KEY=VALUE, got '$kv'"; echo "$kv"; done; } > "$TARGETS/$name.env"
      echo "saved $TARGETS/$name.env"; cmd_device test "$name" ;;
    rm)
      local name=${1:-}; [ -f "$TARGETS/$name.env" ] || die "no such device: $name"
      rm -f "${TARGETS:?}/${name:?}.env"; echo "removed $name" ;;
    test)
      local name=${1:-ws}; [ -f "$TARGETS/$name.env" ] || die "no such device: $name"
      local type
      # shellcheck disable=SC1090
      type=$( unset TYPE; . "$TARGETS/$name.env"; echo "${TYPE:-ssh}" )
      [ "$type" = ssh ] && { cmd_target test "$name"; return; }
      SUPPORT_TARGETS_DIR=$TARGETS SUPPORT_MCP_DIR=$SUPPORT_DIR/mcp "$SUPPORT_DIR/venv/bin/python" - "$name" <<'PY'
import sys, os
sys.path.insert(0, os.environ["SUPPORT_MCP_DIR"])
import connectors
from pathlib import Path
name = sys.argv[1]
cfg = connectors.load_env(Path(os.environ["SUPPORT_TARGETS_DIR"]) / f"{name}.env")
print("  " + connectors.describe(cfg))
c = connectors.make(cfg)
q = {"serial": "", "can": "dump", "modbus": "holding 0 2", "http": "HEAD /"}[cfg["TYPE"].lower()]
try:
    out = c.observe(q, 2)
    print("  ok:", (out.strip().splitlines() or ["(empty)"])[0][:100])
except Exception as e:
    print("  FAIL:", e); sys.exit(1)
PY
      ;;
    *) die "usage: support-ctl device list|add|test|rm" ;;
  esac
}

cmd_scan() {
  local what=${1:-all}
  section() { [ "$what" = all ] || [ "$what" = "$1" ]; }
  if section usb; then
    echo "== USB"
    lsusb 2>/dev/null | grep -v 'Linux Foundation .* root hub' | sed 's/^/  /' || true
  fi
  if section serial; then
    echo "== Serial ports"
    local found=0
    for d in /dev/serial/by-id/*; do [ -e "$d" ] && { printf '  %s -> %s\n' "$(basename "$d")" "$(readlink -f "$d")"; found=1; }; done
    for d in /dev/ttyUSB* /dev/ttyACM*; do [ -e "$d" ] && [ ! -e /dev/serial/by-id ] && { echo "  $d"; found=1; }; done
    [ "$found" = 1 ] || echo "  (none: no USB-serial adapter plugged in)"
  fi
  if section can; then
    echo "== CAN interfaces"
    ip -d -br link 2>/dev/null | awk '$1 ~ /can/ {print "  " $0}' | grep . || echo "  (none: plug a USB-CAN adapter; support-priv can-restart IFACE BITRATE brings it up)"
  fi
  if section net; then
    echo "== Network links"
    ip -br addr | awk '$1!="lo" && $1!~/^(docker|veth|br-)/ {print "  " $0}'
    for ifc in $(ip -br link | awk '$1!="lo" && $1!~/^(docker|veth|br-|can|vcan)/ && $2=="UP"{print $1}'); do
      local net; net=$(ip -4 -o addr show "$ifc" | awk '{print $4}' | head -1); [ -n "$net" ] || continue
      local pfx=${net#*/}; [ "$pfx" -ge 22 ] 2>/dev/null || { echo "== Hosts on $ifc ($net): prefix too wide to sweep"; continue; }
      echo "== Hosts on $ifc ($net)"
      if sudo -n "$SUPPORT_DIR/bin/support-priv" arp-scan "$ifc" 2>/dev/null | awk '{printf "  %-16s %-18s %s\n", $1, $2, substr($0, index($0,$3))}' | grep .; then :; else
        nmap -sn -T4 --max-retries 1 "$net" 2>/dev/null | awk '/Nmap scan report/{h=$5; ip=$6; gsub(/[()]/,"",ip); if(ip=="") ip=h; print "  " ip "  " (h==ip?"":h)}' | grep . || echo "  (nobody answered)"
      fi
      local leases=/var/lib/NetworkManager/dnsmasq-$ifc.leases
      sudo -n test -s "$leases" 2>/dev/null && { echo "  DHCP leases handed out on $ifc:"; sudo -n cat "$leases" | awk '{print "    " $3 "  " $2 "  " $4}'; }
    done
  fi
  if section mdns; then
    echo "== mDNS services (4 s)"
    timeout 5 avahi-browse -atrp 2>/dev/null | awk -F';' '$1=="="{printf "  %-28s %-16s %s %s\n", $4, $8, $5, $7}' | sort -u | grep . || echo "  (none announced)"
  fi
}

cmd_workbench() {
  local sub=${1:-status} repo; repo=$(cat /etc/support/workbench.path 2>/dev/null || echo "$SUPPORT_DIR/..")
  local img; img=$(sed -n 's/^WORKBENCH_IMAGE=//p' "$repo/install/versions.lock" 2>/dev/null); img=${img:-workbench:local}
  case "$sub" in
    build)
      [ -f "$repo/stack/workbench/Dockerfile" ] || die "no Dockerfile at $repo/stack/workbench"
      echo "building $img (python + pyserial/python-can/pymodbus/scapy/esptool; needs internet) ..."
      docker build -q -t "$img" "$repo/stack/workbench" >/dev/null
      echo "  built $img ($(docker image inspect "$img" --format '{{.Size}}' | awk '{printf "%.0f MiB", $1/1048576}'))"
      docker network inspect workbench >/dev/null 2>&1 || docker network create --subnet 172.31.77.0/24 workbench >/dev/null
      mkdir -p "$SUPPORT_DIR/workbench/runs"
      docker run --rm "$img" python3 -c "import serial, can, pymodbus, scapy, esptool, paramiko; print('  sandbox libs ok')" ;;
    status)
      if docker image inspect "$img" >/dev/null 2>&1; then
        echo "  image $img: $(docker image inspect "$img" --format '{{.Created}}' | cut -c1-19)  ($(docker image inspect "$img" --format '{{.Size}}' | awk '{printf "%.0f MiB", $1/1048576}'))"
      else echo "  image $img: NOT BUILT — support-ctl workbench build"; fi
      echo "  network: $(docker network inspect workbench --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}' 2>/dev/null || echo "not created")"
      echo "  runs: $(ls "$SUPPORT_DIR/workbench/runs" 2>/dev/null | wc -l | tr -d ' ') in $SUPPORT_DIR/workbench/runs" ;;
    runs)
      for d in "$SUPPORT_DIR"/workbench/runs/*/; do [ -d "$d" ] && printf '  %s  %s\n' "$(basename "$d")" "$(head -c 80 "$d"/script.* 2>/dev/null | tr '\n' ' ')"; done ;;
    *) die "usage: support-ctl workbench build|status|runs" ;;
  esac
}

cmd_docs() {
  local sub=${1:-status}
  case "$sub" in
    status)
      local bytes; bytes=$(find "$WORKSPACE/docs" -name '*.md' -print0 2>/dev/null | xargs -0 cat 2>/dev/null | wc -c | tr -d ' ')
      local files; files=$(find "$WORKSPACE/docs" -name '*.md' 2>/dev/null | wc -l | tr -d ' ')
      # rough estimate: ~3.5 bytes/token for mixed RU/EN markdown
      echo "  $files files, $bytes bytes, ~$(( bytes * 2 / 7 )) tokens (context limit in opencode.json: 131072)"
      [ $(( bytes * 2 / 7 )) -gt 100000 ] && echo "  WARNING: docs exceed ~100K tokens; split into a system card + search (PLAN.md §8.3)" || true
      find "$WORKSPACE/docs" -type f ! -name '*.md' 2>/dev/null | head -5 | sed 's/^/  ignored (not .md): /' ;;
    reload)
      cmd_docs status
      sudo systemctl restart support-opencode && sleep 3 && sudo systemctl restart support-ui
      echo "  agent engine restarted; start a NEW session so the docs are in context" ;;
    *) die "usage: support-ctl docs status|reload" ;;
  esac
}

cmd_net() {
  local sub=${1:-status} IF=$RJ45_IF
  case "$sub" in
    status)
      echo "  $IF: $(nmcli -g GENERAL.STATE device show "$IF" 2>/dev/null | head -1), profile: $(nmcli -g GENERAL.CONNECTION device show "$IF" 2>/dev/null)"
      ip -br addr show "$IF" | awk '{$1=""; print "  addr:" $0}'
      echo "  uplink: $(ip route show default | awk '{print $5" via "$3}' | head -1)" ;;
    peers)
      echo "  DHCP leases on direct link:"
      sudo cat /var/lib/NetworkManager/dnsmasq-"$IF".leases 2>/dev/null | awk '{print "    " $3 "  " $4 "  " $2}' || true
      echo "  IPv6 link-local neighbours (works even if the peer has no DHCP client):"
      ping -6 -c 2 -W 1 "ff02::1%$IF" >/dev/null 2>&1 || true
      ip -6 neigh show dev "$IF" | awk '$1 ~ /^fe80/ {print "    " $1 "%'"$IF"'  " $3}' ;;
    lan|direct)
      sudo nmcli con up "$sub" >/dev/null && cmd_net status ;;
    hotspot)
      local WIFI=$WIFI_IF SSID=${HOTSPOT_SSID:-Workbench-Support}
      [ -n "$WIFI" ] || die "no Wi-Fi interface found"
      case "${2:-on}" in
        on)
          sudo install -d -m 755 /etc/support
          if ! sudo test -s /etc/support/hotspot.env; then
            printf 'HOTSPOT_PASSWORD=%s\n' "$(head -c 9 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 10)" | sudo tee /etc/support/hotspot.env >/dev/null
            sudo chmod 600 /etc/support/hotspot.env
          fi
          local pw; pw=$(sudo sed -n 's/^HOTSPOT_PASSWORD=//p' /etc/support/hotspot.env)
          if ! nmcli -t -f NAME con show | grep -qx hotspot; then
            sudo nmcli con add type wifi ifname "$WIFI" con-name hotspot ssid "$SSID" \
              802-11-wireless.mode ap 802-11-wireless.band bg ipv4.method shared ipv4.addresses 10.42.0.1/24 \
              ipv6.method disabled wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$pw" connection.autoconnect no >/dev/null
          fi
          sudo nmcli con up hotspot >/dev/null
          echo "  hotspot ON: SSID $SSID, password $pw, GX10 address 10.42.0.1 -> http://10.42.0.1:8080" ;;
        off)
          sudo nmcli con down hotspot >/dev/null 2>&1 || true
          echo "  hotspot OFF (Wi-Fi client reconnects to known networks automatically)" ;;
        auto)
          nmcli -t -f NAME con show | grep -qx hotspot || { cmd_net hotspot on; cmd_net hotspot off; }
          case "${3:-}" in
            on)  sudo nmcli con mod hotspot connection.autoconnect yes connection.autoconnect-priority -10
                 echo "  hotspot AUTO: starts at boot when no known Wi-Fi network is in range (known networks win)" ;;
            off) sudo nmcli con mod hotspot connection.autoconnect no; echo "  hotspot auto-start disabled" ;;
            *) die "usage: support-ctl net hotspot auto on|off" ;;
          esac ;;
        *) die "usage: support-ctl net hotspot on|off|auto on|off" ;;
      esac ;;
    *) die "usage: support-ctl net status|peers|lan|direct|hotspot on|off" ;;
  esac
}

cmd_agent() {
  mkdir -p /var/log/support 2>/dev/null || sudo install -d -o "$(id -u)" /var/log/support
  cd "$WORKSPACE" && exec "$HOME/.opencode/bin/opencode" "$@"
}

cmd_web() {
  local pw=${1:-}
  sudo install -d -m 755 /etc/support
  if [ -n "$pw" ] || ! sudo test -s /etc/support/web.env; then
    [ -n "$pw" ] || pw=$(head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 12)
    printf 'OPENCODE_SERVER_PASSWORD=%s\nSUPPORT_UI_PASSWORD=%s\n' "$pw" "$pw" | sudo tee /etc/support/web.env >/dev/null
    sudo chmod 600 /etc/support/web.env
    echo "web password set (user: support): $pw"
  fi
  # Units are installed (templated for the current user) by install/deploy.sh.
  local repo; repo=$(cat /etc/support/workbench.path 2>/dev/null || echo "$SUPPORT_DIR/..")
  [ -x "$repo/install/gen-certs.sh" ] && "$repo/install/gen-certs.sh"
  sudo systemctl daemon-reload
  sudo systemctl disable --now support-web >/dev/null 2>&1 || true
  sudo systemctl enable --now support-opencode support-ui >/dev/null
  sudo systemctl restart support-opencode support-ui
  if sudo test -s /etc/support/tls/server.crt; then
    sudo systemctl enable --now support-ui-tls >/dev/null && sudo systemctl restart support-ui-tls
  fi
  sleep 4
  systemctl is-active --quiet support-ui || die "support-ui failed: journalctl -u support-ui"
  local ip; ip=$(hostname -I | awk '{print $1}')
  echo "web UI: http://$ip:8080  (login: support)"
  systemctl is-active --quiet support-ui-tls && echo "   HTTPS: https://$ip:8443  — for microphone/PWA from a laptop; install http://$ip:8080/ca.crt there once"
}

cmd_gui() {
  # Wait briefly for the UI to answer (right after boot it may still be starting), then open the browser.
  for _ in $(seq 1 20); do curl -s -o /dev/null -m 2 http://127.0.0.1:8080/api/health && break; sleep 1; done
  local url="http://localhost:8080"
  # DGX OS ships Firefox (snap) but no default browser is registered, so xdg-open alone does nothing.
  if command -v firefox >/dev/null; then exec firefox --new-window "$url" >/dev/null 2>&1; fi
  exec xdg-open "$url" >/dev/null 2>&1
}

cmd_install_desktop() {
  local src=$SUPPORT_DIR/desktop
  install -Dm644 "$src/spark-support.png" "$HOME/.local/share/icons/hicolor/512x512/apps/spark-support.png"
  rm -f "$HOME/.local/share/icons/hicolor/scalable/apps/spark-support.svg"
  install -Dm755 "$src/spark-support.desktop" "$HOME/.local/share/applications/spark-support.desktop"
  mkdir -p "$HOME/Desktop" && install -m755 "$src/spark-support.desktop" "$HOME/Desktop/spark-support.desktop"
  gtk-update-icon-cache -q -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
  update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
  # GNOME shows an untrusted-launcher warning until the file is marked trusted (needs the user's session bus).
  local uid; uid=$(id -u)
  DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$uid/bus} \
    gio set "$HOME/Desktop/spark-support.desktop" metadata::trusted true 2>/dev/null || true
  xdg-settings set default-web-browser firefox_firefox.desktop 2>/dev/null || true
  echo "desktop launcher installed: ~/Desktop/spark-support.desktop (+ app menu entry 'Spark Support')"
}

cmd_self() {
  local f=/var/lib/support/state/self-unlock.json now AUDIT=${SUPPORT_AUDIT_LOG:-/var/log/support/audit.jsonl}; now=$(date +%s)
  case "${1:-status}" in
    unlock)
      local m=${2:-30}; [[ "$m" =~ ^[0-9]+$ ]] && [ "$m" -ge 1 ] && [ "$m" -le 240 ] || die "usage: support-ctl self unlock [1-240 minutes]"
      mkdir -p "$(dirname "$f")"
      printf '{"until": %s, "by": "operator", "via": "cli"}\n' "$((now + m * 60))" > "$f.tmp" && mv "$f.tmp" "$f"
      printf '{"ts": "%s", "tool": "self_unlock", "by": "operator", "via": "cli", "minutes": %s}\n' "$(date -u +%FT%TZ)" "$m" >> "$AUDIT"
      echo "Workbench (self) open for agent changes until $(date -d "@$((now + m * 60))" +%H:%M); each change still asks for approval" ;;
    lock)
      rm -f "$f"; printf '{"ts": "%s", "tool": "self_lock", "by": "operator", "via": "cli"}\n' "$(date -u +%FT%TZ)" >> "$AUDIT"
      echo "Workbench (self) locked: the agent may only read it" ;;
    status)
      local until=0; [ -f "$f" ] && until=$(sed -n 's/.*"until": *\([0-9]*\).*/\1/p' "$f")
      if [ "${until:-0}" -gt "$now" ]; then echo "open until $(date -d "@$until" +%H:%M)"; else echo "locked"; fi ;;
    *) die "usage: support-ctl self unlock [MIN] | lock | status" ;;
  esac
}

cmd_library() { LIBRARY_DIR=${LIBRARY_DIR:-/opt/library} HF_HUB_OFFLINE=1 "$SUPPORT_DIR/venv/bin/python" "$SUPPORT_DIR/mcp/library_core.py" "$@"; }
cmd_bench() { "$SUPPORT_DIR/venv/bin/python" "$SUPPORT_DIR/tests/bench.py" "$@"; }

cmd_update() {
  local repo; repo=$(cat /etc/support/workbench.path 2>/dev/null || echo "$HOME/Workbench")
  [ -d "$repo/.git" ] || die "Workbench checkout not found at $repo (clone it, then: echo PATH | sudo tee /etc/support/workbench.path)"
  git -C "$repo" pull --ff-only
  "$repo/install/deploy.sh"
  echo "updated to $(git -C "$repo" log -1 --format='%h %s')"
}

cmd_version() {
  # shellcheck disable=SC1091
  . /etc/dgx-release 2>/dev/null || true
  echo "  DGX OS:    ${DGX_SWBUILD_VERSION:-?}  kernel $(uname -r)"
  echo "  driver:    $(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null || echo ?)"
  echo "  docker:    $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo ?)  toolkit $(nvidia-ctk --version 2>/dev/null | awk '{print $NF}')"
  echo "  opencode:  $("$HOME/.opencode/bin/opencode" --version 2>/dev/null || echo ?)"
  echo "  vLLM:      $(grep -h '^VLLM_IMAGE=' "$STACK_DIR"/env/fast.env | cut -d= -f2)"
  for d in /opt/models/*/; do [ -f "$d.workbench-rev" ] && echo "  model:     $(basename "$d") @ $(cut -c1-12 "$d.workbench-rev") ($(du -sh "$d" | cut -f1))"; done
  local repo; repo=$(cat /etc/support/workbench.path 2>/dev/null || true)
  [ -n "$repo" ] && echo "  workbench: $(git -C "$repo" log -1 --format='%h %ci' 2>/dev/null || echo "$repo (copy without git)")"
}

case "${1:-}" in
  status) cmd_status ;;
  model)  shift; cmd_model "$@" ;;
  target) shift; cmd_target "$@" ;;
  device) shift; cmd_device "$@" ;;
  scan)   shift; cmd_scan "$@" ;;
  workbench) shift; cmd_workbench "$@" ;;
  docs)   shift; cmd_docs "$@" ;;
  net)    shift; cmd_net "$@" ;;
  agent)  shift; cmd_agent "$@" ;;
  bench)  shift; cmd_bench "$@" ;;
  library) shift; cmd_library "$@" ;;
  self)   shift; cmd_self "$@" ;;
  web)    shift; cmd_web "$@" ;;
  gui)    cmd_gui ;;
  install-desktop) cmd_install_desktop ;;
  update) cmd_update ;;
  version) cmd_version ;;
  *) sed -n '2,20p' "$0"; exit 1 ;;
esac
