[Unit]
Description=Workbench reverse SSH tunnel to the relay VPS (web UI and SSH reachable from anywhere via the VPS)
Documentation=file:///opt/support/manual/operator-manual.pdf
After=network-online.target
Wants=network-online.target
# Configured by `support-ctl tunnel on USER@HOST`: writes /etc/support/tunnel.env (TUNNEL_TARGET, TUNNEL_UI_PORT, TUNNEL_SSH_PORT)
ConditionPathExists=/etc/support/tunnel.env

[Service]
Type=simple
EnvironmentFile=/etc/support/tunnel.env
# Ports are bound on the VPS loopback only; from a laptop: ssh -L 18080:127.0.0.1:18080 -L 2222:127.0.0.1:2222 USER@VPS
ExecStart=/usr/bin/ssh -i /etc/support/tunnel_ed25519 -N \
  -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/etc/support/tunnel_known_hosts \
  -o ConnectTimeout=20 -o BatchMode=yes \
  -R 127.0.0.1:${TUNNEL_UI_PORT}:127.0.0.1:8080 -R 127.0.0.1:${TUNNEL_SSH_PORT}:127.0.0.1:22 ${TUNNEL_TARGET}
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
