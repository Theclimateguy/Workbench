# FAST+MTP experiment: Qwen3.6-35B-A3B NVFP4 (NVIDIA checkpoint), agent worker.
# Flags per NVIDIA dgx-spark-playbooks "Agent-Ready Qwen3.6 35B" and recipes.vllm.ai (GB10).
VLLM_IMAGE=vllm/vllm-openai:v0.28.0
MODEL_PATH=/models/Qwen3.6-35B-A3B-NVFP4
SERVED_NAME=fast
LLM_PORT=8000
MAX_MODEL_LEN=131072
# Unified memory: vLLM recipe caps this at 0.5 on Spark.
GPU_MEM_UTIL=0.45
MODEL_ARGS=--quantization modelopt --kv-cache-dtype fp8 --attention-backend flashinfer --moe-backend marlin --reasoning-parser qwen3 --tool-call-parser qwen3_xml --trust-remote-code --speculative-config '{"method":"mtp","num_speculative_tokens":3}'
# Optional: 3-token MTP draft (test separately, bench before/after)
# MODEL_ARGS=... --speculative-config '{"method":"mtp","num_speculative_tokens":3}'
