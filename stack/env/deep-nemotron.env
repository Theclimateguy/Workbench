# Alternative DEEP profile: Nemotron 3 Super 120B-A12B NVFP4 (retired as default on 2026-10-13, see docs/bench-log.md).
# Use on a box that has the Nemotron weights but not gpt-oss: copy to /etc/support/deep.env — deploy.sh then keeps it
# as env/deep.env across updates. Flags per NVIDIA model card "vLLM on DGX Spark".
# Exclusive with fast (weights ~75 GiB). Reasoning parser nemotron_v3, tool parser qwen3_coder.
VLLM_IMAGE=vllm/vllm-openai:v0.28.0
MODEL_PATH=/models/Nemotron-3-Super-120B-A12B-NVFP4
SERVED_NAME=deep
LLM_PORT=8000
MAX_MODEL_LEN=131072
GPU_MEM_UTIL=0.85
MODEL_ARGS=--quantization fp4 --moe-backend marlin --kv-cache-dtype fp8 --mamba-ssm-cache-dtype float16 --async-scheduling --enable-chunked-prefill --max-num-seqs 4 --reasoning-parser nemotron_v3 --tool-call-parser qwen3_coder --trust-remote-code --speculative-config '{"method":"mtp","num_speculative_tokens":3,"model":"/models/Nemotron-3-Super-MTPv2","moe_backend":"triton"}'
